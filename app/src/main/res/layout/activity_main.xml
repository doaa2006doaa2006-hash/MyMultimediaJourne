<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/profile_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:src="@drawable/multimedia_banner"
            android:scaleType="centerCrop"
            android:contentDescription="@string/profile_title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/profile_title"
            android:textSize="24sp"
            android:textColor="@color/profile_title_color" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/profile_paragraph_one"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/profile_text_color" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp"
            android:text="@string/profile_paragraph_two"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/profile_text_color" />

    </LinearLayout>
</ScrollView>